# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/freecarm

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# AI Model
MODEL_PATH=./models
DAMAGE_DETECTION_MODEL=yolov5_vehicle_damage.onnx

# Anthropic Claude API (for AI damage detection)
ANTHROPIC_API_KEY=

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Pricing Database
DEFAULT_LABOR_RATE=75
DEFAULT_PARTS_MARKUP=1.3
